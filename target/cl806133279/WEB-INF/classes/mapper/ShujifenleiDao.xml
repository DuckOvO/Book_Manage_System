<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cl.dao.ShujifenleiDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.cl.entity.ShujifenleiEntity" id="shujifenleiMap">
        <result property="shujifenlei" column="shujifenlei"/>
    </resultMap>

    <select id="selectListView"
		resultType="com.cl.entity.view.ShujifenleiView" >

		SELECT  shujifenlei.* FROM shujifenlei  shujifenlei 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.cl.entity.view.ShujifenleiView" >
		SELECT * FROM shujifenlei  shujifenlei <where> 1=1 ${ew.sqlSegment}</where>
	</select>



	
</mapper>
